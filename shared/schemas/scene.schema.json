{
  "$defs": {
    "AssetMetadata": {
      "additionalProperties": false,
      "properties": {
        "asset_id": {
          "pattern": "^[a-f0-9-]{36}$",
          "title": "Asset Id",
          "type": "string"
        },
        "generator": {
          "maxLength": 100,
          "title": "Generator",
          "type": "string"
        },
        "model_version": {
          "maxLength": 100,
          "title": "Model Version",
          "type": "string"
        },
        "source_prompt": {
          "default": "",
          "maxLength": 4000,
          "title": "Source Prompt",
          "type": "string"
        },
        "source_image": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9-]{36}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Image"
        },
        "generated_at": {
          "maxLength": 80,
          "title": "Generated At",
          "type": "string"
        },
        "geometry_format": {
          "const": "GLB",
          "default": "GLB",
          "title": "Geometry Format",
          "type": "string"
        },
        "texture_assets": {
          "items": {
            "additionalProperties": true,
            "type": "object"
          },
          "maxItems": 32,
          "title": "Texture Assets",
          "type": "array"
        },
        "license_metadata": {
          "additionalProperties": true,
          "title": "License Metadata",
          "type": "object"
        },
        "provenance": {
          "additionalProperties": true,
          "title": "Provenance",
          "type": "object"
        }
      },
      "required": [
        "asset_id",
        "generator",
        "model_version",
        "generated_at"
      ],
      "title": "AssetMetadata",
      "type": "object"
    },
    "Environment": {
      "additionalProperties": false,
      "properties": {
        "ground": {
          "default": true,
          "title": "Ground",
          "type": "boolean"
        },
        "background": {
          "default": "#181d27",
          "pattern": "^#[0-9a-fA-F]{6}$",
          "title": "Background",
          "type": "string"
        }
      },
      "title": "Environment",
      "type": "object"
    },
    "Facades": {
      "additionalProperties": false,
      "properties": {
        "front": {
          "items": {
            "$ref": "#/$defs/Opening"
          },
          "maxItems": 24,
          "title": "Front",
          "type": "array"
        },
        "back": {
          "items": {
            "$ref": "#/$defs/Opening"
          },
          "maxItems": 24,
          "title": "Back",
          "type": "array"
        },
        "left": {
          "items": {
            "$ref": "#/$defs/Opening"
          },
          "maxItems": 24,
          "title": "Left",
          "type": "array"
        },
        "right": {
          "items": {
            "$ref": "#/$defs/Opening"
          },
          "maxItems": 24,
          "title": "Right",
          "type": "array"
        }
      },
      "title": "Facades",
      "type": "object"
    },
    "Opening": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "default": "window",
          "enum": [
            "window",
            "door"
          ],
          "title": "Kind",
          "type": "string"
        },
        "floor": {
          "default": 0,
          "maximum": 2,
          "minimum": 0,
          "title": "Floor",
          "type": "integer"
        },
        "x": {
          "default": 0,
          "maximum": 50,
          "minimum": -50,
          "title": "X",
          "type": "number"
        },
        "sill": {
          "default": 0.9,
          "maximum": 5,
          "minimum": 0,
          "title": "Sill",
          "type": "number"
        },
        "width": {
          "default": 1.2,
          "exclusiveMinimum": 0.15,
          "maximum": 5,
          "title": "Width",
          "type": "number"
        },
        "height": {
          "default": 1.2,
          "exclusiveMinimum": 0.15,
          "maximum": 4,
          "title": "Height",
          "type": "number"
        }
      },
      "title": "Opening",
      "type": "object"
    },
    "PBR": {
      "additionalProperties": false,
      "properties": {
        "baseColor": {
          "default": "#dc7355",
          "pattern": "^#[0-9a-fA-F]{6}$",
          "title": "Basecolor",
          "type": "string"
        },
        "metalness": {
          "default": 0,
          "maximum": 1,
          "minimum": 0,
          "title": "Metalness",
          "type": "number"
        },
        "roughness": {
          "default": 0.6,
          "maximum": 1,
          "minimum": 0,
          "title": "Roughness",
          "type": "number"
        },
        "opacity": {
          "default": 1,
          "maximum": 1,
          "minimum": 0,
          "title": "Opacity",
          "type": "number"
        },
        "transparent": {
          "default": false,
          "title": "Transparent",
          "type": "boolean"
        },
        "doubleSided": {
          "default": false,
          "title": "Doublesided",
          "type": "boolean"
        },
        "emissive": {
          "default": "#000000",
          "pattern": "^#[0-9a-fA-F]{6}$",
          "title": "Emissive",
          "type": "string"
        }
      },
      "title": "PBR",
      "type": "object"
    },
    "Parameters": {
      "additionalProperties": false,
      "properties": {
        "facades": {
          "anyOf": [
            {
              "$ref": "#/$defs/Facades"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "balcony_facade": {
          "default": "front",
          "enum": [
            "front",
            "back",
            "left",
            "right"
          ],
          "title": "Balcony Facade",
          "type": "string"
        },
        "balcony_offset": {
          "default": 0,
          "maximum": 50,
          "minimum": -50,
          "title": "Balcony Offset",
          "type": "number"
        },
        "width": {
          "default": 8,
          "exclusiveMinimum": 0,
          "maximum": 100,
          "title": "Width",
          "type": "number"
        },
        "depth": {
          "default": 10,
          "exclusiveMinimum": 0,
          "maximum": 100,
          "title": "Depth",
          "type": "number"
        },
        "height": {
          "default": 2,
          "exclusiveMinimum": 0,
          "maximum": 100,
          "title": "Height",
          "type": "number"
        },
        "radius": {
          "default": 1,
          "exclusiveMinimum": 0,
          "maximum": 50,
          "title": "Radius",
          "type": "number"
        },
        "floors": {
          "default": 2,
          "maximum": 3,
          "minimum": 1,
          "title": "Floors",
          "type": "integer"
        },
        "floor_height": {
          "default": 3,
          "maximum": 5,
          "minimum": 2,
          "title": "Floor Height",
          "type": "number"
        },
        "roof_type": {
          "default": "gable",
          "enum": [
            "flat",
            "gable",
            "shed",
            "hip"
          ],
          "title": "Roof Type",
          "type": "string"
        },
        "roof_angle": {
          "default": 30,
          "maximum": 60,
          "minimum": 5,
          "title": "Roof Angle",
          "type": "number"
        },
        "wall_color": {
          "default": "#ecebe4",
          "pattern": "^#[0-9a-fA-F]{6}$",
          "title": "Wall Color",
          "type": "string"
        },
        "roof_color": {
          "default": "#515967",
          "pattern": "^#[0-9a-fA-F]{6}$",
          "title": "Roof Color",
          "type": "string"
        },
        "color": {
          "default": "#dc7355",
          "pattern": "^#[0-9a-fA-F]{6}$",
          "title": "Color",
          "type": "string"
        },
        "windows": {
          "default": 4,
          "maximum": 24,
          "minimum": 0,
          "title": "Windows",
          "type": "integer"
        },
        "doors": {
          "default": 1,
          "maximum": 3,
          "minimum": 0,
          "title": "Doors",
          "type": "integer"
        },
        "balcony": {
          "default": false,
          "title": "Balcony",
          "type": "boolean"
        },
        "steps": {
          "default": false,
          "title": "Steps",
          "type": "boolean"
        },
        "garage": {
          "default": false,
          "title": "Garage",
          "type": "boolean"
        },
        "yard": {
          "default": false,
          "title": "Yard",
          "type": "boolean"
        },
        "style": {
          "default": "japanese",
          "enum": [
            "modern",
            "japanese"
          ],
          "title": "Style",
          "type": "string"
        }
      },
      "title": "Parameters",
      "type": "object"
    },
    "SceneObject": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[A-Za-z0-9_-]{1,64}$",
          "title": "Id",
          "type": "string"
        },
        "name": {
          "default": "Object",
          "maxLength": 100,
          "title": "Name",
          "type": "string"
        },
        "type": {
          "enum": [
            "house",
            "cube",
            "sphere",
            "cylinder",
            "cone",
            "plane",
            "torus",
            "table",
            "chair",
            "cabinet",
            "bookshelf",
            "bed",
            "imported"
          ],
          "title": "Type",
          "type": "string"
        },
        "parent": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Parent"
        },
        "position": {
          "default": [
            0,
            0,
            0
          ],
          "maxItems": 3,
          "minItems": 3,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "Position",
          "type": "array"
        },
        "rotation": {
          "default": [
            0,
            0,
            0
          ],
          "maxItems": 3,
          "minItems": 3,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "Rotation",
          "type": "array"
        },
        "scale": {
          "default": [
            1,
            1,
            1
          ],
          "maxItems": 3,
          "minItems": 3,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "Scale",
          "type": "array"
        },
        "visible": {
          "default": true,
          "title": "Visible",
          "type": "boolean"
        },
        "asset": {
          "anyOf": [
            {
              "$ref": "#/$defs/AssetMetadata"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "locked": {
          "default": false,
          "title": "Locked",
          "type": "boolean"
        },
        "source_id": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9_-]{1,64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Id"
        },
        "material": {
          "anyOf": [
            {
              "$ref": "#/$defs/PBR"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "anchor": {
          "default": "bottom",
          "enum": [
            "center",
            "bottom"
          ],
          "title": "Anchor",
          "type": "string"
        },
        "relation": {
          "anyOf": [
            {
              "enum": [
                "left_of",
                "right_of",
                "in_front_of",
                "behind",
                "above",
                "below",
                "next_to"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Relation"
        },
        "reference_object_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reference Object Id"
        },
        "spacing": {
          "default": 0.4,
          "maximum": 50,
          "minimum": 0,
          "title": "Spacing",
          "type": "number"
        },
        "parameters": {
          "$ref": "#/$defs/Parameters"
        }
      },
      "required": [
        "id",
        "type"
      ],
      "title": "SceneObject",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Version",
      "type": "string"
    },
    "name": {
      "default": "Untitled",
      "maxLength": 100,
      "title": "Name",
      "type": "string"
    },
    "units": {
      "const": "meters",
      "default": "meters",
      "title": "Units",
      "type": "string"
    },
    "objects": {
      "items": {
        "$ref": "#/$defs/SceneObject"
      },
      "maxItems": 50,
      "title": "Objects",
      "type": "array"
    },
    "environment": {
      "$ref": "#/$defs/Environment"
    }
  },
  "required": [
    "objects"
  ],
  "title": "Scene",
  "type": "object"
}